//-
  E-commerce product page — Pug 마크업 초안
  출처: ecommerce-product-page.fig (✨ Designs 캔버스)
    - Mobile / Mobile Menu / Mobile - Basket Filled·Empty (375px)
    - Tablet / Tablet Menu / Tablet - Active - Basket Filled·Empty (768px)
    - Desktop / Desktop - Active - Basket Filled·Empty / Desktop - Lightbox (1440px)

  반응형 전환 요약 (CSS에서 처리할 내용, 마크업은 하나로 공유)
    - 메뉴: 모바일·태블릿은 햄버거 버튼 + 좌측 드로어(배경 dim), 데스크톱은 가로 내비게이션
    - 갤러리: 모바일·태블릿은 이전/다음 화살표 캐러셀, 데스크톱은 썸네일 4개 + 라이트박스
    - 가격: 모바일은 할인가·배지·정가가 한 줄, 태블릿·데스크톱은 정가가 아래 줄
    - 구매 영역: 좁으면 수량/버튼 세로 배치, 넓으면 가로 배치 (.l-switcher)

  자산 경로는 Frontend Mentor 기본 파일명을 가정한 placeholder다.
  현재 저장소의 src/images에는 favicon만 있으므로 Figma에서 내보내 추가해야 한다.
  아이콘은 ./images/icons.svg 스프라이트(#icon-*)를 가정한다.

//- ==========================================================
//- 데이터
//- ==========================================================
-
  const product = {
    brand: 'Sneaker Company',
    title: 'Fall Limited Edition Sneakers',
    description: 'These low-profile sneakers are your perfect casual wear companion. Featuring a durable rubber outer sole, they’ll withstand everything the weather can offer.',
    price: '$125.00',
    discount: '50%',
    originalPrice: '$250.00',
  };
  const images = [
    { src: './images/image-product-1.jpg', thumb: './images/image-product-1-thumbnail.jpg', alt: 'A pair of white and beige sneakers on an orange background, one standing upright to show its white rubber sole' },
    { src: './images/image-product-2.jpg', thumb: './images/image-product-2-thumbnail.jpg', alt: 'Two sneakers balanced on stacked stones beside a dry branch' },
    { src: './images/image-product-3.jpg', thumb: './images/image-product-3-thumbnail.jpg', alt: 'A single sneaker resting on two stones in front of a curved orange backdrop' },
    { src: './images/image-product-4.jpg', thumb: './images/image-product-4-thumbnail.jpg', alt: 'Side view of a sneaker resting on stacked stones' },
  ];
  const navLinks = ['Collections', 'Men', 'Women', 'About', 'Contact'];

//- ==========================================================
//- 믹스인
//- ==========================================================

//- 장식용 아이콘: 버튼의 이름은 .u-sr-only 텍스트가 제공하므로 항상 숨긴다.
mixin icon(name, width, height)
  svg(aria-hidden="true" focusable="false" width=width height=height)&attributes(attributes)
    use(href=`./images/icons.svg#icon-${name}`)

//- 썸네일 목록: 데스크톱 갤러리와 라이트박스에서 재사용한다.
//- 선택된 항목은 .is-active + aria-current="true"로 상태를 함께 표현한다.
mixin thumbnails(base, controls)
  ul(class=`${base}__thumbs l-cluster` role="list")
    each image, index in images
      li(class=`${base}__thumb-item`)
        - const isActive = index === 0;
        button(
          type="button"
          class=[`${base}__thumb`, isActive && 'is-active']
          aria-current=isActive ? 'true' : false
          aria-controls=controls
          data-index=index
        )
          span(class=`${base}__thumb-frame l-frame`)
            img(src=image.thumb alt="" width="88" height="88")
          span.u-sr-only View image #{index + 1} of #{images.length}

//- ==========================================================
//- 문서
//- ==========================================================
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title #{product.title} | #{product.brand}
    link(rel="icon" type="image/png" sizes="32x32" href="./images/favicon-32x32.png")
    link(rel="stylesheet" href="./css/style.css")
    script(src="./js/main.js" defer)

  body
    a.c-skip-link(href="#main") Skip to main content

    //- ------------------------------------------------------
    //- Header (Figma: Header Container / Navigation Container)
    //- 1110px 컨테이너, 하단 구분선 #e4e9f2
    //- ------------------------------------------------------
    header.c-header
      .c-header__inner.l-center.l-cluster(data-justify="between")

        //- Logo Container: 햄버거 + 로고 + 내비게이션 (가로 Auto Layout, gap 56)
        .c-header__start.l-cluster
          //- 모바일·태블릿 전용. 데스크톱에서는 CSS로 숨긴다.
          button.c-header__menu-toggle.c-icon-button(
            type="button"
            aria-expanded="false"
            aria-controls="primary-nav"
          )
            +icon('menu', 16, 15)
            span.u-sr-only Open menu

          a.c-header__logo(href="/")
            img(src="./images/logo.svg" alt="sneakers" width="138" height="20")

          //-
            Navigation Links (가로 Auto Layout, gap 32)
            모바일·태블릿: 열림 시 .is-open, 250px(모바일)/301px(태블릿) 좌측 드로어로 전환하고
            목록은 세로(gap 24, Bold 18px)로 바꾼다.
            닫힘 상태의 드로어는 inert 또는 visibility: hidden으로 키보드·보조기술에서 제외한다.
            데스크톱 hover: 글자색 #1d2026 + 하단 4px #ff7e1b 강조선 (Figma "Women" 상태)
          nav#primary-nav.c-header__nav.c-nav(aria-label="Primary")
            button.c-nav__close.c-icon-button(type="button" aria-controls="primary-nav")
              +icon('close', 14, 15)
              span.u-sr-only Close menu
            ul.c-nav__list.l-cluster(role="list")
              each link in navLinks
                li.c-nav__item
                  a.c-nav__link(href="#") #{link}

          //- 드로어 배경 dim (Figma: Lightbox Background, #000 75%) — 순수 장식
          .c-header__backdrop(aria-hidden="true" hidden)

        //- User Actions Container (가로 Auto Layout, gap 48 / 모바일 24)
        .c-header__actions.l-cluster
          button#cart-toggle.c-header__cart.c-icon-button(
            type="button"
            aria-expanded="false"
            aria-controls="cart-panel"
          )
            +icon('cart', 22, 20)
            span.u-sr-only Cart
            //- 장바구니가 비면 배지를 hidden 처리한다 (Figma: Basket Empty)
            span.c-header__badge.c-badge.c-badge--count
              | 3
              span.u-sr-only  items

          //- 데스크톱 hover: 2px #ff7e1b 테두리. 목적지는 확정되지 않은 placeholder.
          a.c-header__avatar.c-avatar(href="#")
            img.c-avatar__image(src="./images/image-avatar.png" alt="" width="50" height="50")
            span.u-sr-only My account

          //-
            Cart Container (세로 Auto Layout, 360px, radius 10, 그림자)
            비모달 팝오버: 장바구니 버튼의 aria-expanded와 hidden을 함께 토글한다.
            모바일에서는 화면 상단 중앙(좌우 8px 여백)에 배치한다.
          section#cart-panel.c-header__cart-panel.c-cart(aria-labelledby="cart-title" hidden)
            h2#cart-title.c-cart__title Cart

            .c-cart__body.l-stack
              //- Basket Filled 상태
              ul.c-cart__list.l-stack(role="list")
                li.c-cart__item.l-cluster
                  .c-cart__thumb.l-frame
                    img(src=images[0].thumb alt="" width="50" height="50")
                  .c-cart__info
                    p.c-cart__name= product.title
                    p.c-cart__price
                      span.c-cart__unit #{product.price} × 3
                      |
                      strong.c-cart__total $375.00
                  button.c-cart__remove.c-icon-button(type="button")
                    +icon('delete', 14, 16)
                    span.u-sr-only Remove #{product.title} from cart

              button.c-cart__checkout.c-button.c-button--primary.c-button--block(type="button") Checkout

              //- Basket Empty 상태: 목록·결제 버튼을 hidden 처리하고 이 문구를 표시한다
              p.c-cart__empty(hidden) Your cart is empty.

      //- 장바구니 추가·삭제 결과 안내 (시각적으로 숨김)
      p#cart-status.u-sr-only(role="status")

    //- ------------------------------------------------------
    //- Main (Figma: Product Section, 가로 Auto Layout gap 128)
    //- ------------------------------------------------------
    main#main.c-page(tabindex="-1")
      article.c-product.l-center
        //- 좁은 화면(모바일·태블릿)은 세로, 넓은 화면(데스크톱)은 2단으로 전환
        .c-product__layout.l-switcher

          //-
            Product Image Container (세로 Auto Layout, gap 32)
            모바일: 375×300 풀블리드, radius 0 / 태블릿: 608×290, radius 15 / 데스크톱: 448×445, radius 15
            비율(--n, --d)은 분기점별로 CSS에서 지정한다.
          section.c-product__gallery.c-gallery(aria-label="Product images")
            .c-gallery__stage
              //-
                데스크톱: 클릭 시 라이트박스(dialog)를 연다.
                모바일·태블릿 디자인에는 라이트박스가 없으므로, 해당 분기점에서는
                JS로 disabled 처리하거나 라이트박스 제공 여부를 결정해야 한다.
              button.c-gallery__open(type="button" aria-haspopup="dialog" aria-controls="lightbox")
                span.c-gallery__frame.l-frame
                  img#gallery-image.c-gallery__image(
                    src=images[0].src
                    alt=images[0].alt
                    width="448"
                    height="445"
                  )
                span.u-sr-only Open larger view

              //- Navigation Arrows: 모바일·태블릿 전용 (40×40 원형, 흰색)
              button.c-gallery__control.c-gallery__control--prev.c-icon-button.c-icon-button--round(
                type="button"
                aria-controls="gallery-image"
              )
                +icon('previous', 12, 18)
                span.u-sr-only Previous image
              button.c-gallery__control.c-gallery__control--next.c-icon-button.c-icon-button--round(
                type="button"
                aria-controls="gallery-image"
              )
                +icon('next', 13, 18)
                span.u-sr-only Next image

            p.c-gallery__status.u-sr-only(role="status") Image 1 of #{images.length}

            //- Thumbnail Images Container: 데스크톱 전용 (88×88, gap 32)
            //- 선택 상태: 테두리 2px #ff7e1b + 흰색 75% 오버레이 / hover: 흰색 50% 오버레이
            +thumbnails('c-gallery', 'gallery-image')

          //- Product Details Container (세로 Auto Layout, gap 32 / 모바일 gap 16~32)
          .c-product__details.l-stack
            .c-product__heading.l-stack
              p.c-product__brand= product.brand
              h1.c-product__title= product.title
            p.c-product__description= product.description

            //- Price Container: 모바일 한 줄(양 끝 정렬), 태블릿·데스크톱은 정가가 아래로 내려간다
            .c-product__price.c-price.l-cluster(data-justify="between")
              .c-price__sale.l-cluster
                p.c-price__current
                  span.u-sr-only Current price:
                  | #{product.price}
                span.c-price__badge.c-badge.c-badge--discount
                  | #{product.discount}
                  span.u-sr-only  off
              p.c-price__original
                span.u-sr-only Original price:
                del= product.originalPrice

            //- Add to Cart Section: 좁으면 세로(gap 16), 넓으면 가로
            form.c-product__purchase.c-purchase.l-switcher(action="#" method="post")
              //- 수량 0에서는 감소 버튼을 비활성 상태로 둔다 (Figma: Mobile 기본값 0)
              .c-purchase__quantity.c-quantity(role="group" aria-labelledby="quantity-label")
                span#quantity-label.u-sr-only Quantity
                button.c-quantity__button.c-quantity__button--decrease.is-disabled(
                  type="button"
                  aria-disabled="true"
                  aria-controls="quantity-value"
                )
                  +icon('minus', 12, 4)
                  span.u-sr-only Decrease quantity
                output#quantity-value.c-quantity__value(
                  aria-labelledby="quantity-label"
                  aria-live="polite"
                ) 0
                button.c-quantity__button.c-quantity__button--increase(
                  type="button"
                  aria-controls="quantity-value"
                )
                  +icon('plus', 12, 12)
                  span.u-sr-only Increase quantity
                input#quantity-input(type="hidden" name="quantity" value="0")

              //- Primary 버튼 (#ff7e1b, hover #ffab6a, radius 10, 그림자)
              button.c-purchase__submit.c-button.c-button--primary(type="submit")
                span.l-with-icon
                  +icon('cart', 17, 16).icon.l-icon
                  | Add to cart

    //- ------------------------------------------------------
    //- Lightbox (Figma: Desktop - Lightbox, 550px, 배경 #000 75%)
    //- 네이티브 모달 dialog: showModal()로 열고 닫힐 때 .c-gallery__open으로 포커스를 복원한다.
    //- ------------------------------------------------------
    dialog#lightbox.c-lightbox.l-imposter(aria-labelledby="lightbox-title")
      .c-lightbox__inner.l-stack
        h2#lightbox-title.u-sr-only Product image gallery

        //- Close Button: 흰색, hover #ff7e1b
        button.c-lightbox__close.c-icon-button(type="button")
          +icon('close', 14, 15)
          span.u-sr-only Close gallery

        .c-lightbox__stage
          .c-lightbox__frame.l-frame
            img#lightbox-image.c-lightbox__image(
              src=images[0].src
              alt=images[0].alt
              width="550"
              height="550"
            )
          //- 56×56 원형 화살표, 이미지 가장자리에 반쯤 걸치게 배치
          button.c-lightbox__control.c-lightbox__control--prev.c-icon-button.c-icon-button--round.c-icon-button--large(
            type="button"
            aria-controls="lightbox-image"
          )
            +icon('previous', 12, 18)
            span.u-sr-only Previous image
          button.c-lightbox__control.c-lightbox__control--next.c-icon-button.c-icon-button--round.c-icon-button--large(
            type="button"
            aria-controls="lightbox-image"
          )
            +icon('next', 13, 18)
            span.u-sr-only Next image

        p.c-lightbox__status.u-sr-only(role="status") Image 1 of #{images.length}

        +thumbnails('c-lightbox', 'lightbox-image')

    footer.c-attribution
      p
        | Challenge by
        a(href="https://www.frontendmentor.io?ref=challenge") Frontend Mentor
        | . Coded by
        a(href="https://www.frontendmentor.io/profile/jonghwascript") jonghwascript
        | .
